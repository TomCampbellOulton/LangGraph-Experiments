LLAMA_CPP_BASE_URL=http://llama-cpp:8085/v1
LLAMA_CPP_MODEL=Qwen3.5-9B-Q4_K_M.gguf
LLAMA_CPP_API_KEY=not-needed

# For our offline coding agent, using our Pi harness but an agent version (so it doesn't tamper with our regular one)
# Slightly odd name for provider since PI takes the name llama-cpp
PI_PROVIDER=local-llm-using-llama-cpp
PI_MODEL=Qwen3.5-9B-Q4_K_M.gguf
#PI_CODING_AGENT_DIR=/app/pi-config

HF_HOME=/app/hf-cache
# Stops any network traffic from hugging face
HF_HUB_OFFLINE=1
# Blocks the progress bars from hugging face - removes the loading weights bar
HF_HUB_DISABLE_PROGRESS_BARS=1
# Remove all hugging face warnings
HF_HUB_DISABLE_TELEMETRY=1